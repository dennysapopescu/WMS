# ==============================================================================
# Warehouse Management System (WMS) - Environment Configuration Template
# Copy this file to .env and adjust the values according to your environment.
# ==============================================================================

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/wms_db?createDatabaseIfNotExist=true&serverTimezone=UTC
DB_USERNAME=wms_user
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# Security & Session / Remember-Me Signing Key
JWT_SECRET=change_me_super_secret_key_at_least_32_characters_long

# Initial Seed Credentials (for dev / demo profile)
ADMIN_PASSWORD=admin123
OPERATOR_PASSWORD=operator123
VIEWER_PASSWORD=viewer123

# Server & Profile Configuration
SPRING_PROFILES_ACTIVE=dev
PORT=8080
